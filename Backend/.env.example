NODE_ENV=development
PORT=5000

# Primary frontend origin. Used as a CORS fallback.
CLIENT_URL=http://localhost:5173

# Public URL of the main Frontend application.
# Password reset emails use this URL to build /reset-password?token=...
FRONTEND_PUBLIC_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=

# Public URL of this backend. Used in certificate download/verification URLs.
BACKEND_PUBLIC_URL=http://localhost:5000

# Public URL of the Course application. Used in certificate verification QR URLs.
COURSE_PUBLIC_URL=http://localhost:5174

MONGO_URI=mongodb://127.0.0.1:27017/ApnaAcademy

JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret

# DSA Premium pricing. The frontend never controls these values.
DSA_PREMIUM_PRICE_INR=299
DSA_PREMIUM_DURATION_DAYS=30

# Secure DSA judge service. Keep the secret identical on Backend and Judge service.
# The judge service must call POST /api/v1/dsa/submissions/:id/judge-result.
JUDGE_SERVICE_URL=http://localhost:6000
JUDGE_SERVICE_SECRET=replace-with-a-long-random-judge-secret

# Gmail SMTP credentials used by the existing email service.
APP_EMAIL=your-email@gmail.com
APP_PASSWORD=your-gmail-app-password

# Production API hardening
# Set TRUST_PROXY=true only when the deployment proxy/load balancer is trusted.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
DSA_SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
DSA_SUBMISSION_RATE_LIMIT_MAX=10
REQUEST_TIMEOUT_MS=150000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000

# Refer & Earn Phase 3
# ₹199 reward after a referred user's first successful normal course purchase
# meeting the minimum qualifying amount. Values are integer paise.
REFERRAL_REWARD_PAISE=19900
REFERRAL_MIN_PURCHASE_PAISE=49900

# Refer & Earn withdrawal limits (integer paise)
REFERRAL_MIN_WITHDRAWAL_PAISE=19900
REFERRAL_MAX_WITHDRAWAL_PAISE=10000000


# Refer & Earn Phase 6 fraud/risk thresholds (risk score 0-100)
# Scores at/above review require manual review; scores at/above block are rejected.
REFERRAL_RISK_REVIEW_SCORE=40
REFERRAL_RISK_BLOCK_SCORE=70


# RazorpayX Refer & Earn payouts
# RazorpayX API calls are server-to-server only. Keep all values private.
# Razorpay's current documentation states the API key pair is shared with the
# Payment Gateway, but these separate environment names keep payout configuration
# isolated in the application configuration layer.
RAZORPAYX_ENABLED=false
RAZORPAYX_KEY_ID=replace-with-your-razorpayx-key-id
RAZORPAYX_KEY_SECRET=replace-with-your-razorpayx-key-secret
RAZORPAYX_ACCOUNT_NUMBER=replace-with-your-razorpayx-customer-or-current-account-number
RAZORPAYX_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
RAZORPAYX_TIMEOUT_MS=15000

# HMAC key used to bind the full payout destination to its server-side
# provider fund-account reference without storing the full bank account number.
REFERRAL_PAYOUT_DESTINATION_HMAC_SECRET=replace-with-a-long-random-secret
# AES-256-GCM key material for encrypted UPI/provider destination secrets.
REFERRAL_PAYOUT_DESTINATION_ENCRYPTION_KEY=replace-with-a-dedicated-long-random-secret

# Referral / payout abuse protection
REFERRAL_MUTATION_RATE_LIMIT_WINDOW_MS=60000
REFERRAL_MUTATION_RATE_LIMIT_MAX=8
REFERRAL_WITHDRAWAL_RATE_LIMIT_WINDOW_MS=600000
REFERRAL_WITHDRAWAL_RATE_LIMIT_MAX=3
REFERRAL_PAYOUT_DESTINATION_RATE_LIMIT_WINDOW_MS=600000
REFERRAL_PAYOUT_DESTINATION_RATE_LIMIT_MAX=5

# ApnaAcademy Interview AI — server-side only
# Never expose NVIDIA_API_KEY to Vite/React (do not prefix with VITE_).
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_TIMEOUT_MS=120000

INTERVIEW_AI_RATE_LIMIT_WINDOW_MS=60000
INTERVIEW_AI_RATE_LIMIT_MAX=20
