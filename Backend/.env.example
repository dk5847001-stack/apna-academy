NODE_ENV=development
PORT=5000

# Primary frontend origin. Used as a CORS fallback.
CLIENT_URL=http://localhost:5173

# Comma-separated browser origins allowed to call the API.
# Add the production Frontend, Dashboard, Course, and Admin URLs here.
# Example:
# CORS_ALLOWED_ORIGINS=https://www.example.com,https://dashboard.example.com,https://course.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Public URL of this backend. Used in certificate download/verification URLs.
# Example: https://api.example.com
BACKEND_PUBLIC_URL=http://localhost:5000

# Public URL of the Course application. Used in certificate verification QR URLs.
# Example: https://course.example.com
COURSE_PUBLIC_URL=http://localhost:5174

MONGO_URI=mongodb://127.0.0.1:27017/ApnaAcademy

JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
