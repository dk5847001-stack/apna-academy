{
  "name": "interview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run seo:generate && npm run seo:validate && npm run performance:validate && npm run seo:final && vite build && npm run seo:static && npm run seo:static:validate",
    "lint": "oxlint",
    "preview": "vite preview",
    "seo:generate": "node scripts/generate-seo.mjs",
    "seo:validate": "node scripts/validate-seo.mjs",
    "performance:validate": "node scripts/validate-performance.mjs",
    "seo:final": "node scripts/validate-final-seo.mjs",
    "seo:static": "node scripts/generate-static-seo.mjs",
    "seo:static:validate": "node scripts/validate-static-seo.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.0"
  }
}
