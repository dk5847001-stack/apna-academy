NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/apnaacademy_quiz
CLIENT_ORIGINS=http://localhost:5173
QUIZ_ATTEMPT_TTL_BUFFER_SECONDS=15

# Admin authentication
ADMIN_EMAIL=admin@example.com
# Format: scrypt$base64url(salt)$base64url(derivedKey)
ADMIN_PASSWORD_HASH=scrypt$REPLACE_SALT$REPLACE_DERIVED_KEY
# Generate a strong random secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
